# Environment for docker-compose.dokploy.yml (Dokploy compose "Environment" tab). Never commit real values.
SITE_ENV=development                     # must equal the CI image tag (development | production)
NEXT_PUBLIC_SITE_URL=https://development.kefkenahsap.com
SITE_BASIC_AUTH=                         # user:password; required when SITE_ENV=development (fails closed)

# Hex only (openssl rand -hex 24): embedded in connection URLs.
POSTGRES_PASSWORD=
PAYLOAD_SECRET=
UMAMI_APP_SECRET=

# Cloudflare R2 (S3 API). Media is public through the CDN host.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=kefkenahsap
# Optional per-environment key prefix inside a shared bucket (e.g. dev)
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_URL=https://cdn.kefkenahsap.com

OPENROUTER_API_KEY=
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=kefkenahsapdekorasyon@gmail.com
NEXT_PUBLIC_GA_ID=G-S84WKG63MS
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional GlitchTip: set COMPOSE_PROFILES=observability.
# The umami/glitchtip databases are created by the db-init service on every deploy (idempotent).
COMPOSE_PROFILES=
SENTRY_DSN=
GLITCHTIP_SECRET_KEY=                    # required with the observability profile (openssl rand -hex 32)
GLITCHTIP_DOMAIN=
GLITCHTIP_FROM_EMAIL=
