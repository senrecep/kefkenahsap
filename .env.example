# Copy to .env for local development.
DATABASE_URL=postgres://kefken:kefken@localhost:5433/kefken
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# S3-compatible media storage (local: RustFS from docker compose --profile local; prod: Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
# Optional per-environment key prefix inside a shared bucket (e.g. dev)
S3_PREFIX=
S3_BUCKET=kefken-media
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true
# Public base URL media is served from (prod: https://cdn.kefkenahsap.com)
MEDIA_PUBLIC_URL=http://localhost:9000/kefken-media

# AI (OpenRouter) and e-mail (Resend)
OPENROUTER_API_KEY=
# 1 = every AI task uses the deterministic fake model (src/ai/fake.ts); local dev, tests and CI. Never set in the deployed app.
AI_FAKE_PROVIDER=1
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=kefkenahsapdekorasyon@gmail.com

# Analytics
NEXT_PUBLIC_GA_ID=G-S84WKG63MS
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
